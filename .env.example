# ============================================================
# مركز شباب الحوراني — Environment variables
# انسخ الملف ده إلى .env وعدّل القيم. ممنوع commit ملف .env
# ============================================================

# --- Django core ---
SECRET_KEY=change-me-to-a-long-random-string
# سريعًا للتجربة على نفس الشبكة (Wi‑Fi) بس — للإنتاج غيّره لـ False بلا استثناء
DEBUG=True
# wildcard مسموح حاليًا للتجربة على الموبايل — لازم تتقيد بالدومين في الإنتاج
ALLOWED_HOSTS=*,192.168.1.73
CSRF_TRUSTED_ORIGINS=*,http://192.168.1.73:8000

# --- Database ---
# Development (default): SQLite file at project root
DATABASE_URL=sqlite:///db.sqlite3
# Production (Neon) example — pooled connection + sslmode:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.eu-central-1.aws.neon.tech/DBNAME?sslmode=require
CONN_MAX_AGE=600

# --- Center fallback identity (used only if DB is unreachable during migrate) ---
DEFAULT_CENTER_NAME_AR=مركز شباب الحوراني
DEFAULT_CENTER_NAME_EN=Al-Hourani Youth Sports Center

# --- Media storage ---
# False = local filesystem (MEDIA_ROOT). True = upload everything to Cloudinary.
USE_CLOUDINARY=False
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (OTP عبر البريد — مجاني عبر Brevo: 300 إيميل/يوم) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
OTP_PROVIDER=email
DEFAULT_FROM_EMAIL="مركز شباب الحوراني <salehrabia87@gmail.com>"
# التسليم الفعلي عبر Brevo (https://app.brevo.com → Settings → SMTP & API → تبويب SMTP):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=<SMTP Login — ينسخ حرفيًا من Settings → SMTP & API>
# EMAIL_HOST_PASSWORD=<SMTP key — يظهر مرة واحدة وقت الإنشاء>
# Gmail SMTP (بديل): EMAIL_HOST=smtp.gmail.com / EMAIL_HOST_USER=<جيميلك> / EMAIL_HOST_PASSWORD=<App Password>

# --- Payments (mock for now; swap to Paymob in Phase 4) ---
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=mock-secret
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=

# --- Notifications (mock for now) ---
NOTIFICATIONS_PROVIDER=console
# (OTP_PROVIDER اتحدد فوق في قسم Email)

# --- Monitoring (optional) ---
SENTRY_DSN=
PUBLIC_BASE_URL=https://hourani-sports.eg
